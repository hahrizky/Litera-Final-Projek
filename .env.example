# ============================================================
# LITERA - Environment Variables Template
# ============================================================
# Salin file ini menjadi .env dan isi dengan nilai yang sebenarnya.
# JANGAN commit file .env ke GitHub!
# Copy this file to .env and fill in the real values.
# NEVER commit .env to GitHub!
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- Firebase ---
# Firebase hanya dipakai oleh Authentication dan Cloud Firestore.
# Jangan aktifkan Firebase Storage untuk upload buku atau foto profil.
