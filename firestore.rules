rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role client tidak dipakai untuk otorisasi; gunakan custom claim `admin`
    // yang hanya dapat dibuat melalui Firebase Admin SDK.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Books collection: anyone can read, only admin can write
    match /books/{bookId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'ratingsCount', 'totalRatingSum', 'averageRating', 'totalReviews', 'totalRatings', 'star1', 'star2', 'star3', 'star4', 'star5']));
      
      // Ratings subcollection
      match /ratings/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
    }

    // User private data
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      match /bookmarks/{docId} {
        allow read, write: if isOwner(userId);
      }
      
      match /history/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /favorites/{docId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
